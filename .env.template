# Base de datos (docker compose)
# El contenedor "tienda-deportiva-db" expone PostgreSQL en el puerto 5433
# para no chocar con otros proyectos que usen el 5432.
DB_USER=postgres
DB_NAME=tienda_deportiva
DB_PASSWORD=cambiar_esta_clave

# Para correr Next.js fuera de Docker (npm run dev).
# Dentro de Docker el host es "db" (interno) y docker-compose lo arma solo.
DATABASE_URL="postgresql://postgres:cambiar_esta_clave@localhost:5433/tienda_deportiva"

# NextAuth (generar con: npx auth secret)
AUTH_SECRET=

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Cloudinary
CLOUDINARY_URL=
